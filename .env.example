BOT_TOKEN=123456:replace_with_your_manager_bot_token
OWNER_IDS=123456789

# MongoDB Atlas URI or another MongoDB-compatible URI. Required.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=force_sub_manager

# Optional legacy API key for your own old integrations.
# Friends should use their personal key from /apikey rotate instead.
API_SECRET=

# Optional sharing controls.
# Friends can activate their own isolated workspace with /invite this-code.
INVITE_CODE=change-this-invite-code
ALLOW_SELF_SERVICE=false

# Set this on Render/Koyeb/etc. Example: https://your-service.onrender.com
PUBLIC_URL=

# Optional. If omitted, the app creates a per-start webhook secret.
WEBHOOK_SECRET=change-this-too

# Optional. Comma separated saved channels for OWNER_IDS on first boot.
# CHANNELS=@mypublicchannel,-1001234567890
